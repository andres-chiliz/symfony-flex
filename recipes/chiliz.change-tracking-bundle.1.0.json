{
    "manifests": {
        "chiliz/change-tracking-bundle": {
            "manifest": {
                "bundles": {
                    "Chiliz\\ChangeTrackingBundle\\ChilizChangeTrackingBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/packages/chiliz_change_tracking.yaml": "config/packages/chiliz_change_tracking.yaml"
                },
                "post-install-output": [
                    "Congratulations, you've installed chiliz/change-tracking-bundle.",
                    "",
                    "Now you need to go to config/packages/chiliz_change_tracking.yaml and update the configuration.",
                    ""
                ]
            },
            "files": {
                "config/packages/chiliz_change_tracking.yaml": {
                    "contents": [
                        "chiliz_change_tracking_bundle:",
                        "    connections:",
                        "        default:",
                        "            serviceName: '%service_name%'",
                        "    export:",
                        "        awsS3:",
                        "            key:    '%env(AWS_IAM_KEY)%'",
                        "            secret: '%env(AWS_IAM_SECRET)%'",
                        "            region: '%env(AWS_REGION)%'",
                        "            bucket: '%env(AWS_S3_BUCKET_CHANGE_TRACKING)%'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "6475e1269cd05ad231f59311d76d7ad22834f343"
        }
    }
}