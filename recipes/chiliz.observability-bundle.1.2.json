{
    "manifests": {
        "chiliz/observability-bundle": {
            "manifest": {
                "bundles": {
                    "Symfony\\Bundle\\MonologBundle\\MonologBundle": [
                        "all"
                    ],
                    "Sentry\\SentryBundle\\SentryBundle": [
                        "dev",
                        "prod"
                    ],
                    "Chiliz\\ObservabilityBundle\\ChilizObservabilityBundle": [
                        "all"
                    ]
                },
                "env": {
                    "#1": "The Sentry DSN",
                    "SENTRY_DSN": "",
                    "#2": "The release tag to be used in Sentry",
                    "RELEASE_TAG": "",
                    "#3": "The rate of sample that we are sending to sentry",
                    "SENTRY_TRACES_SAMPLE_RATE": "0.0",
                    "#4": "The path monolog is writing logs [PRODUCTION ONLY]",
                    "LOG_FILE_PATH": "php://stdout"
                },
                "copy-from-recipe": {
                    "config/packages/chiliz_observability.yaml": "config/packages/chiliz_observability.yaml"
                }
            },
            "files": {
                "config/packages/chiliz_observability.yaml": {
                    "contents": [
                        "chiliz_observability:",
                        "    environment_name: '%env(DEPLOYMENT_ENVIRONMENT)%'",
                        "    service_name: '%service_name%'",
                        "    sentry:",
                        "        dsn: '%env(SENTRY_DSN)%'",
                        "        release: '%env(RELEASE_TAG)%'",
                        "        traces_sample_rate: '%env(SENTRY_TRACES_SAMPLE_RATE)%'",
                        "    open_telemetry:",
                        "        metrics_interval: '%env(OPENTELEMERTY_METRICS_INTERVAL)%'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "503c8ca8f33769d8c5ea1c32b360a4f315c45108"
        }
    }
}