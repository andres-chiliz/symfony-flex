{
    "manifests": {
        "chiliz/gitlab-api-client-bundle": {
            "manifest": {
                "bundles": {
                    "Chiliz\\GitlabApiBundle\\GitlabApiBundle": [
                        "all"
                    ]
                },
                "env": {
                    "GITLAB_API_BASE_URL": "",
                    "GITLAB_API_TOKEN": ""
                },
                "copy-from-recipe": {
                    "config/packages/chiliz_gitlab_api.yaml": "config/packages/chiliz_gitlab_api.yaml"
                }
            },
            "files": {
                "config/packages/chiliz_gitlab_api.yaml": {
                    "contents": [
                        "chiliz_gitlab_api:",
                        "  api_url: '%env(GITLAB_API_BASE_URL)%'",
                        "  api_token: '%env(GITLAB_API_TOKEN)%'"
                    ],
                    "executable": false
                }
            },
            "ref": "a1255e2c15f0c94dbba4f8e7cc1d03c5c77b4fad"
        }
    }
}