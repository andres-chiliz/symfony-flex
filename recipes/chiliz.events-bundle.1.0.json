{
    "manifests": {
        "chiliz/events-bundle": {
            "manifest": {
                "bundles": {
                    "Chiliz\\EventsBundle\\ChilizEventBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/packages/chiliz_events.yaml": "config/packages/chiliz_events.yaml"
                },
                "post-install-output": [
                    "Congratulations, you've installed chiliz/events-bundle.",
